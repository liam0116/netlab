# =============================================================================
# nginx 設定範本（web 容器）
#
# 這是「範本」：容器啟動時，nginx 官方映像會把 ${NGINX_LISTEN}
# 換成環境變數的值，輸出到 /etc/nginx/conf.d/default.conf。
#   NGINX_LISTEN   nginx 監聽的位址:port，預設 80
# 其他像 $uri、$host 這類 nginx 內建變數不會被替換。
# =============================================================================
server {
    listen ${NGINX_LISTEN};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;   # 不在回應中顯示 nginx 版本
    include /etc/nginx/snippets/security-headers.conf;

    # PWA 安裝資訊（nginx 預設的 mime.types 沒有 .webmanifest）
    types {
        application/manifest+json webmanifest;
    }
    include /etc/nginx/mime.types;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;
    gzip_min_length 1024;

    # 健康檢查（Docker HEALTHCHECK 使用）
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 打包後的 JS / CSS 檔名含 hash，可以永久快取
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Vue Router（history 模式）：找不到的路徑一律回 index.html，
    # 這樣直接開 /project/rack 或重新整理才不會 404。
    # index.html、sw.js（離線快取）不快取，才能馬上拿到新版本。
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
