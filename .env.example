# =============================================================================
# Server Engineer Network Lab — Docker 設定檔
#
# 使用方式：
#   cp .env.example .env     然後修改 .env
#   docker compose up -d     重新啟動才會套用（不需要 --build）
#
# 規則：「=」右邊留空就是使用預設值。不要在「=」兩邊加空白。
# =============================================================================

# 網頁在主機上的 port。開啟 http://localhost:8080
# 8080 被其他程式佔用時改成例如 8088
WEB_PORT=8080

# 誰可以開這個網頁：
#   127.0.0.1 = 只有這台電腦（預設）
#   0.0.0.0   = 同網段的其他電腦 / 手機也能開（例如投影給客戶、同事一起看）
WEB_BIND=127.0.0.1

# 測試環境（docker-compose.test.yml）的網頁 port，預設 8081
TEST_WEB_PORT=
